#pragma once
// ============================================================
//  Local settings — copy to secrets.h and fill in.
//  secrets.h is git-ignored; install.py writes it for you.
//
//  Anything defined here WINS over the default in config.h, so
//  you never have to edit a tracked file. Delete a line to fall
//  back to the default.
// ============================================================

// ── MQTT (optional; the keyer works fine without a broker) ──
#define MQTT_USER  "iot"
#define MQTT_PASS  ""
